}

// M2 Phase 1: one row per institution per session, with a separate child
// table for per-campus date overrides (decision #9: institution-wide with
// optional per-campus override). See project-tracking/M2-PEOPLE-ACADEMIC-DESIGN.md
// § 4.2. StudentEnrollment/StudentHistory relations land with Phase 3 below.
model AcademicYear {
  id             String    @id @default(uuid()) @db.Uuid
  institutionId  String    @map("institution_id") @db.Uuid
  name           String
  startDate      DateTime  @map("start_date") @db.Timestamptz(3)
  endDate        DateTime  @map("end_date") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deleteReason   String?   @map("delete_reason")
  activeScopeKey String    @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  institution            Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campusOverrides        AcademicYearCampusOverride[]
  currentForInstitutions Institution[]                @relation("InstitutionCurrentAcademicYear")
  // M2 Phase 3 (decision #21): every StudentEnrollment/StudentHistory row
  // scoped to this session.
  enrollments            StudentEnrollment[]
  studentHistory         StudentHistory[]

  @@unique([institutionId, name, activeScopeKey], map: "academic_year_name_unique")
  @@index([institutionId])
  @@map("academic_years")
}

model AcademicYearCampusOverride {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  campusId       String    @map("campus_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Timestamptz(3)
  endDate        DateTime? @map("end_date") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deleteReason   String?   @map("delete_reason")
  activeScopeKey String    @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  campus       Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, campusId, activeScopeKey], map: "academic_year_campus_override_unique")
  @@index([campusId])
  @@map("academic_year_campus_overrides")
}

// M2 Phase 3 (decision #21): per-year placement record, source of truth for
// "what class/section is this student in this year," replacing the direct
// Student.classId/sectionId pointer. Coexists with StudentHistory rather
// than absorbing it: this is the queryable one-row-per-year placement that
// exams/fees/attendance reports join through so historical report cards
// keep rendering correctly forever; StudentHistory stays the append-only
// transition log (can carry multiple rows within one academic year, e.g. a
// mid-year section transfer). See
// project-tracking/M2-PEOPLE-ACADEMIC-DESIGN.md § 4.3/§ 4.4.
//
// classId/sectionId/academicYearId/campusId (and studentId) are all
// onDelete: Cascade rather than SetNull — deliberate, so the recycle bin's
// cascade-safety guard (ENTITY_CASCADE_CHILDREN) blocks a permanent delete
// of any class/section/campus/academic year/student that still has an
// ACTIVE enrollment pointing at it.
model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  academicYearId String           @map("academic_year_id") @db.Uuid
  // Denormalized from Student at creation — same convention as
  // TeacherSubject.campusId, avoids a class -> level -> campus join on every
  // scoped list query.
  campusId       String           @map("campus_id") @db.Uuid
  classId        String           @map("class_id") @db.Uuid
  // Nullable only for un-sectioned intake, mirrors TeacherSubject.sectionId's
  // existing precedent.
  sectionId      String?          @map("section_id") @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  leftDate       DateTime?        @map("left_date") @db.Timestamptz(3)
  leftReason     String?          @map("left_reason")
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?          @map("deleted_by") @db.Uuid
  deleteReason   String?          @map("delete_reason")
  activeScopeKey String           @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  campus       Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  class        AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  section      Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, activeScopeKey], map: "student_enrollment_unique")
  @@index([campusId, academicYearId])
  @@index([classId])
  @@index([sectionId])
  @@index([studentId])
  @@map("student_enrollments")
}

model Student {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @unique @map("user_id") @db.Uuid
  // M2 Phase 3 (decision #25): denormalized from campus.institutionId at
  // creation so regNo uniqueness can be scoped per institution at the DB
  // level (a unique index can't walk campusId -> Campus.institutionId at
  // query time). Fixes the latent cross-tenant regNo collision — this
  // column didn't exist before, so the old unique constraint was only
  // [regNo, activeScopeKey], unique across the entire shared database.
  institutionId  String              @map("institution_id") @db.Uuid
  regNo          String              @map("reg_no")
  dob            DateTime            @db.Timestamptz(3)
  gender         Gender
  cnic           String?
  campusId       String              @map("campus_id") @db.Uuid
  picture        String?
  religion       Religion?
  admissionDate  DateTime            @map("admission_date") @db.Timestamptz(3)
  prevSchool     String?             @map("prev_school")
  reference      String?
  createdBy      String?             @map("created_by") @db.Uuid
  updatedBy      String?             @map("updated_by") @db.Uuid
  deletedAt      DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?             @map("deleted_by") @db.Uuid
  deleteReason   String?             @map("delete_reason")
  activeScopeKey String              @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus         Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  guardians      StudentGuardian[]
  history        StudentHistory[]
  fines          StudentFine[]
  discounts      StudentDiscount[]
  vouchers       FeeVoucher[]
  contacts       Contact[]           @relation("StudentContacts")
  // M2 Phase 3 (decision #21): source of truth for class/section placement,
  // replacing the removed classId/sectionId columns above.
  enrollments    StudentEnrollment[]

  @@unique([institutionId, regNo, activeScopeKey], map: "student_reg_no_institution_unique")
  @@index([campusId])
  @@map("students")
}

model Guardian {
