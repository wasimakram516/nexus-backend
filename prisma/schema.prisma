generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  STAFF
  STUDENT
  GUARDIAN
}

enum UserStatus {
  ACTIVE
  RESIGNED
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Religion {
  ISLAM
  CHRISTIANITY
  HINDUISM
  OTHER
}

enum GuardianRelation {
  FATHER
  MOTHER
  UNCLE
  AUNT
  OTHER
}

enum ContactPersonType {
  STUDENT
  GUARDIAN
  STAFF
}

// M2 Phase 2 (StaffProfile generalization, decision #12): every employee now
// states explicitly whether they teach. Non-teaching staff simply never get
// TeacherSubject rows — see StaffProfile below.
enum EmploymentType {
  TEACHING
  NON_TEACHING
}

// M2 Phase 3 (decision #21): exactly 3 values, no REPEATED value — a
// repeater's old-year row is marked PROMOTED like anyone else, the fact that
// newClassId == previousClassId lives in the paired StudentHistory row.
enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum SalaryStatus {
  ACTIVE
  UPDATED
  TERMINATED
}

enum DeductionType {
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum AdjustmentType {
  BONUS
  DEDUCTION
}

enum DiscountType {
  SIBLING
  MERIT
  NEED_BASED
  STAFF_CHILD
}

enum FineStatus {
  PENDING
  PAID
}

enum VoucherStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DeploymentMode {
  SHARED_HOSTED
  DEDICATED_HOSTED
  SELF_HOSTED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum ModuleKey {
  ACADEMICS
  ATTENDANCE
  FINANCE
  PEOPLE
  REPORTING
  EXAMINATIONS
  DOCUMENTS
  REALTIME
}

enum CustomFieldInputType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  DATE
  DATETIME
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  BOOLEAN
  FILE
  IMAGE
  URL
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  institutionId       String?            @map("institution_id") @db.Uuid
  name                String
  email               String
  passwordHash        String             @map("password_hash")
  role                UserRole
  status              UserStatus         @default(ACTIVE)
  createdBy           String?            @map("created_by") @db.Uuid
  updatedBy           String?            @map("updated_by") @db.Uuid
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(3)
  deletedBy           String?            @map("deleted_by") @db.Uuid
  deleteReason        String?            @map("delete_reason")
  activeScopeKey      String             @default("ACTIVE") @map("active_scope_key")
  /// Login identifier for non-staff archetypes: registration number for STUDENT, phone for GUARDIAN. Null for STAFF/ADMIN/SUPERADMIN, who authenticate with email.
  identifier          String?
  roleId              String?            @map("role_id") @db.Uuid
  permissionOverrides Json?              @map("permission_overrides")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution         Institution?       @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  assignedRole        Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshSessions     RefreshSession[]
  campuses            UserCampus[]
  student             Student?
  guardian            Guardian?
  staffProfile        StaffProfile?
  receivedFees        FeePayment[]       @relation("FeePaymentReceivedBy")
  paidSalaries        SalaryPayment[]    @relation("SalaryPaymentPaidBy")
  approvedDiscounts   StudentDiscount[]  @relation("StudentDiscountApprovedBy")
  adjustedSalaries    SalaryAdjustment[] @relation("SalaryAdjustmentAdjustedBy")
  auditLogs           AuditLog[]

  @@unique([email, activeScopeKey], map: "user_email_active_scope_unique")
  @@unique([identifier, activeScopeKey], map: "user_identifier_active_scope_unique")
  @@index([institutionId])
  @@index([role, status])
  @@map("users")
}

model Institution {
  id                     String                    @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String
  status                 InstitutionStatus         @default(ACTIVE)
  deploymentMode         DeploymentMode            @default(SHARED_HOSTED) @map("deployment_mode")
  primaryDomain          String?                   @map("primary_domain")
  contactEmail           String?                   @map("contact_email")
  contactPhone           String?                   @map("contact_phone")
  notes                  String?
  createdBy              String?                   @map("created_by") @db.Uuid
  updatedBy              String?                   @map("updated_by") @db.Uuid
  deletedAt              DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  deletedBy              String?                   @map("deleted_by") @db.Uuid
  deleteReason           String?                   @map("delete_reason")
  activeScopeKey         String                    @default("ACTIVE") @map("active_scope_key")
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                  User[]
  campuses               Campus[]
  branding               InstitutionBranding?
  settings               InstitutionSetting[]
  entitlements           InstitutionEntitlement[]
  plans                  PlanDefinition[]
  subscriptions          InstitutionSubscription[]
  roles                  Role[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  auditLogs              AuditLog[]
  academicYears          AcademicYear[]
  // M2 Phase 1 (decision #9): single pointer FK to the institution's active
  // session, matching the existing User.roleId -> Role "pointer to the one
  // active association" pattern rather than a boolean-flag-plus-index.
  currentAcademicYearId  String?                   @map("current_academic_year_id") @db.Uuid
  currentAcademicYear    AcademicYear?             @relation("InstitutionCurrentAcademicYear", fields: [currentAcademicYearId], references: [id], onDelete: SetNull)
  // M2 Phase 3 (decision #25): Student.institutionId is now denormalized
  // directly onto Student (see below) so regNo uniqueness can be scoped per
  // institution at the DB level.
  students               Student[]

  @@unique([slug, activeScopeKey], map: "institution_slug_active_scope_unique")
  @@index([status])
  @@map("institutions")
}

model PlanDefinition {
  id              String                    @id @default(uuid()) @db.Uuid
  institutionId   String?                   @map("institution_id") @db.Uuid
  key             String
  name            String
  description     String?
  basePrice       Decimal?                  @map("base_price") @db.Decimal(10, 2)
  currency        String                    @default("PKR")
  billingCycle    BillingCycle              @default(MONTHLY) @map("billing_cycle")
  setupFee        Decimal?                  @map("setup_fee") @db.Decimal(10, 2)
  deploymentModes Json                      @map("deployment_modes")
  defaultModules  Json                      @map("default_modules")
  limits          Json                      @map("limits")
  metadata        Json?
  isActive        Boolean                   @default(true) @map("is_active")
  createdBy       String?                   @map("created_by") @db.Uuid
  updatedBy       String?                   @map("updated_by") @db.Uuid
  deletedAt       DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  deletedBy       String?                   @map("deleted_by") @db.Uuid
  deleteReason    String?                   @map("delete_reason")
  activeScopeKey  String                    @default("ACTIVE") @map("active_scope_key")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution     Institution?              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  subscriptions   InstitutionSubscription[]

  @@unique([key, activeScopeKey], map: "plan_definition_key_active_scope_unique")
  @@index([institutionId])
  @@map("plan_definitions")
}

model RefreshSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy    String?   @map("deleted_by") @db.Uuid
  deleteReason String?   @map("delete_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model Campus {
  id                    String                       @id @default(uuid()) @db.Uuid
  institutionId         String?                      @map("institution_id") @db.Uuid
  name                  String
  location              String
  studentStartTime      String                       @map("student_start_time")
  studentEndTime        String                       @map("student_end_time")
  staffStartTime        String                       @map("staff_start_time")
  staffEndTime          String                       @map("staff_end_time")
  lateThreshold         Int                          @map("late_threshold")
  earlyLeaveThreshold   Int                          @map("early_leave_threshold")
  createdBy             String?                      @map("created_by") @db.Uuid
  updatedBy             String?                      @map("updated_by") @db.Uuid
  deletedAt             DateTime?                    @map("deleted_at") @db.Timestamptz(3)
  deletedBy             String?                      @map("deleted_by") @db.Uuid
  deleteReason          String?                      @map("delete_reason")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution           Institution?                 @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  userAssignments       UserCampus[]
  levels                Level[]
  students              Student[]
  guardians             Guardian[]
  staffProfiles         StaffProfile[]
  teacherSubjects       TeacherSubject[]
  attendanceRecords     Attendance[]
  salaries              StaffSalary[]
  salaryRules           SalaryDeductionRule[]
  salaryPayments        SalaryPayment[]
  salaryAdjustments     SalaryAdjustment[]
  salarySummaries       SalaryDeductionSummary[]
  bankAccounts          BankAccount[]
  feeStructures         FeeStructure[]
  fineRules             StudentFineRule[]
  studentFines          StudentFine[]
  academicYearOverrides AcademicYearCampusOverride[]
  // M2 Phase 1 (§ 7.2, applied in a later phase): short institution-unique
  // code used as the {CAMPUS} token in regNo patterns. Nullable, no backfill
  // required — falls back to the first 3 letters of the campus name.
  code                  String?                      @map("code")
  // M2 Phase 3: denormalized campusId on StudentEnrollment (see model doc).
  studentEnrollments    StudentEnrollment[]

  @@index([institutionId])
  @@map("campuses")
}

model InstitutionBranding {
  id                   String      @id @default(uuid()) @db.Uuid
  institutionId        String      @unique @map("institution_id") @db.Uuid
  displayName          String?     @map("display_name")
  logoUrl              String?     @map("logo_url")
  primaryColorLight    String?     @map("primary_color_light")
  secondaryColorLight  String?     @map("secondary_color_light")
  accentColorLight     String?     @map("accent_color_light")
  backgroundColorLight String?     @map("background_color_light")
  primaryColorDark     String?     @map("primary_color_dark")
  secondaryColorDark   String?     @map("secondary_color_dark")
  accentColorDark      String?     @map("accent_color_dark")
  backgroundColorDark  String?     @map("background_color_dark")
  theme                String?
  createdBy            String?     @map("created_by") @db.Uuid
  updatedBy            String?     @map("updated_by") @db.Uuid
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz(3)
  deletedBy            String?     @map("deleted_by") @db.Uuid
  deleteReason         String?     @map("delete_reason")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("institution_branding")
}

model InstitutionSetting {
  id             String      @id @default(uuid()) @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  key            String
  value          Json
  description    String?
  createdBy      String?     @map("created_by") @db.Uuid
  updatedBy      String?     @map("updated_by") @db.Uuid
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?     @map("deleted_by") @db.Uuid
  deleteReason   String?     @map("delete_reason")
  activeScopeKey String      @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, key, activeScopeKey], map: "institution_setting_unique")
  @@map("institution_settings")
}

model InstitutionEntitlement {
  id             String      @id @default(uuid()) @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  moduleKey      ModuleKey   @map("module_key")
  isEnabled      Boolean     @default(true) @map("is_enabled")
  configuration  Json?       @map("configuration")
  createdBy      String?     @map("created_by") @db.Uuid
  updatedBy      String?     @map("updated_by") @db.Uuid
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?     @map("deleted_by") @db.Uuid
  deleteReason   String?     @map("delete_reason")
  activeScopeKey String      @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, moduleKey, activeScopeKey], map: "institution_entitlement_unique")
  @@map("institution_entitlements")
}

model InstitutionSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  institutionId  String             @map("institution_id") @db.Uuid
  planId         String?            @map("plan_id") @db.Uuid
  agreedPrice    Decimal?           @map("agreed_price") @db.Decimal(10, 2)
  currency       String?
  billingCycle   BillingCycle?      @map("billing_cycle")
  setupFee       Decimal?           @map("setup_fee") @db.Decimal(10, 2)
  discountAmount Decimal?           @map("discount_amount") @db.Decimal(10, 2)
  pricingNotes   String?            @map("pricing_notes")
  status         SubscriptionStatus @default(TRIAL)
  startsAt       DateTime?          @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz(3)
  autoRenew      Boolean            @default(false) @map("auto_renew")
  metadata       Json?
  createdBy      String?            @map("created_by") @db.Uuid
  updatedBy      String?            @map("updated_by") @db.Uuid
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?            @map("deleted_by") @db.Uuid
  deleteReason   String?            @map("delete_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution    Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  plan           PlanDefinition?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([institutionId, status])
  @@index([planId])
  @@map("institution_subscriptions")
}

model CustomFieldDefinition {
  id              String               @id @default(uuid()) @db.Uuid
  institutionId   String               @map("institution_id") @db.Uuid
  moduleKey       ModuleKey            @map("module_key")
  entityType      String               @map("entity_type")
  fieldKey        String               @map("field_key")
  label           String
  inputType       CustomFieldInputType @map("input_type")
  placeholder     String?              @map("placeholder")
  helpText        String?              @map("help_text")
  defaultValue    Json?                @map("default_value")
  options         Json?
  validation      Json?
  visibilityRules Json?                @map("visibility_rules")
  planKeys        Json?                @map("plan_keys")
  isRequired      Boolean              @default(false) @map("is_required")
  isActive        Boolean              @default(true) @map("is_active")
  sortOrder       Int                  @default(0) @map("sort_order")
  createdBy       String?              @map("created_by") @db.Uuid
  updatedBy       String?              @map("updated_by") @db.Uuid
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(3)
  deletedBy       String?              @map("deleted_by") @db.Uuid
  deleteReason    String?              @map("delete_reason")
  activeScopeKey  String               @default("ACTIVE") @map("active_scope_key")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution     Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  values          CustomFieldValue[]

  @@unique([institutionId, entityType, fieldKey, activeScopeKey], map: "custom_field_definition_unique")
  @@index([institutionId, moduleKey, entityType])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                 String                @id @default(uuid()) @db.Uuid
  institutionId      String                @map("institution_id") @db.Uuid
  definitionId       String                @map("definition_id") @db.Uuid
  entityId           String                @map("entity_id")
  value              Json
  definitionSnapshot Json?                 @map("definition_snapshot")
  createdBy          String?               @map("created_by") @db.Uuid
  updatedBy          String?               @map("updated_by") @db.Uuid
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz(3)
  deletedBy          String?               @map("deleted_by") @db.Uuid
  deleteReason       String?               @map("delete_reason")
  activeScopeKey     String                @default("ACTIVE") @map("active_scope_key")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution        Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  definition         CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId, activeScopeKey], map: "custom_field_value_unique")
  @@index([institutionId, entityId])
  @@map("custom_field_values")
}

/// Institution-defined role: a named bundle of feature×action permissions (see
/// PERMISSION_CATALOG) assignable to STAFF/STUDENT/GUARDIAN users. ADMIN/SUPERADMIN
/// bypass this entirely. Role management stays with the institution ADMIN — a
/// "Campus Admin" role is just a full-permission Role scoped via UserCampus, not a
/// distinct mechanism.
model Role {
  id             String      @id @default(uuid()) @db.Uuid
  institutionId  String      @map("institution_id") @db.Uuid
  name           String
  description    String?
  /// Feature x action matrix: { "students": { "create": true, "read": true, ... }, ... }
  permissions    Json
  createdBy      String?     @map("created_by") @db.Uuid
  updatedBy      String?     @map("updated_by") @db.Uuid
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?     @map("deleted_by") @db.Uuid
  deleteReason   String?     @map("delete_reason")
  activeScopeKey String      @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users          User[]

  @@unique([institutionId, name, activeScopeKey], map: "role_unique")
  @@map("roles")
}

model UserCampus {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  campusId       String    @map("campus_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by") @db.Uuid
  deleteReason   String?   @map("delete_reason")
  activeScopeKey String    @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus         Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([userId, campusId, activeScopeKey], map: "user_campus_unique")
  @@index([userId, campusId])
  @@map("user_campus")
}

model Level {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  campusId     String          @map("campus_id") @db.Uuid
  createdBy    String?         @map("created_by") @db.Uuid
  updatedBy    String?         @map("updated_by") @db.Uuid
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(3)
  deletedBy    String?         @map("deleted_by") @db.Uuid
  deleteReason String?         @map("delete_reason")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  campus       Campus          @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classes      AcademicClass[]

  @@index([campusId])
  @@map("levels")
}

model AcademicClass {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  levelId         String              @map("level_id") @db.Uuid
  createdBy       String?             @map("created_by") @db.Uuid
  updatedBy       String?             @map("updated_by") @db.Uuid
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedBy       String?             @map("deleted_by") @db.Uuid
  deleteReason    String?             @map("delete_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  level           Level               @relation(fields: [levelId], references: [id], onDelete: Cascade)
  sections        Section[]
  subjects        Subject[]
  // M2 Phase 3 (decision #21): replaces the direct Student.classId pointer.
  enrollments     StudentEnrollment[]
  historyPrevious StudentHistory[]    @relation("StudentHistoryPreviousClass")
  historyNew      StudentHistory[]    @relation("StudentHistoryNewClass")
  teacherSubjects TeacherSubject[]
  feeStructures   FeeStructure[]
  fineRules       StudentFineRule[]

  @@index([levelId])
  @@index([createdAt])
  @@map("classes")
}

model Section {
  id              String              @id @default(uuid()) @db.Uuid
  name            String
  classId         String              @map("class_id") @db.Uuid
  createdBy       String?             @map("created_by") @db.Uuid
  updatedBy       String?             @map("updated_by") @db.Uuid
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedBy       String?             @map("deleted_by") @db.Uuid
  deleteReason    String?             @map("delete_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  class           AcademicClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  // M2 Phase 3 (decision #21): replaces the direct Student.sectionId pointer.
  enrollments     StudentEnrollment[]
  teacherSubjects TeacherSubject[]
  historyPrevious StudentHistory[]    @relation("StudentHistoryPreviousSection")
  historyNew      StudentHistory[]    @relation("StudentHistoryNewSection")

  @@index([classId])
  @@index([createdAt])
  @@map("sections")
}

model Subject {
