// M2 Phase 2: generalized from the legacy Teacher model to cover both
// teaching and non-teaching employees (decision #12). Table renamed in place
// (teachers -> staff_profiles) rather than dropped and recreated, so existing
// rows/ids survive. See project-tracking/M2-PEOPLE-ACADEMIC-DESIGN.md § 4.5.
model StaffProfile {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @map("user_id") @db.Uuid
  employmentType EmploymentType   @map("employment_type")
  // Free text, not an enum — institutions define their own designations;
  // per-designation profile fields come from Custom Fields, not a fixed list.
  designation    String
  cnic           String?
  gender         Gender
  campusId       String           @map("campus_id") @db.Uuid
  picture        String?
  joiningDate    DateTime         @map("joining_date") @db.Timestamptz(3)
  createdBy      String?          @map("created_by") @db.Uuid
  updatedBy      String?          @map("updated_by") @db.Uuid
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?          @map("deleted_by") @db.Uuid
  deleteReason   String?          @map("delete_reason")
  activeScopeKey String           @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus         Campus           @relation(fields: [campusId], references: [id], onDelete: Cascade)
  // Model name unchanged (still a teaching-specific concept) — only its FK
  // column renames. Non-teaching staff simply never get rows here.
  subjects       TeacherSubject[]
  contacts       Contact[]        @relation("StaffProfileContacts")

  @@index([campusId])
  @@index([employmentType])
  @@map("staff_profiles")
}

model TeacherSubject {
  id             String        @id @default(uuid()) @db.Uuid
  staffProfileId String        @map("staff_profile_id") @db.Uuid
  classId        String        @map("class_id") @db.Uuid
  subjectId      String        @map("subject_id") @db.Uuid
  // Allocation is section-level; nullable only so pre-section rows survive.
  sectionId      String?       @map("section_id") @db.Uuid
  campusId       String        @map("campus_id") @db.Uuid
  createdBy      String?       @map("created_by") @db.Uuid
  updatedBy      String?       @map("updated_by") @db.Uuid
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?       @map("deleted_by") @db.Uuid
  deleteReason   String?       @map("delete_reason")
  activeScopeKey String        @default("ACTIVE") @map("active_scope_key")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  staffProfile   StaffProfile  @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  class          AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section        Section?      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  campus         Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, classId, subjectId, sectionId, campusId, activeScopeKey], map: "teacher_subject_unique")
  @@index([campusId])
  @@index([subjectId])
  @@index([sectionId])
  @@map("teacher_subjects")
}

model Attendance {
