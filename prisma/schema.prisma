  @@index([studentId, guardianId])
  @@map("student_guardian")
}

model StudentHistory {
  id                String         @id @default(uuid()) @db.Uuid
  studentId         String         @map("student_id") @db.Uuid
  previousClassId   String?        @map("previous_class_id") @db.Uuid
  previousSectionId String?        @map("previous_section_id") @db.Uuid
  newClassId        String?        @map("new_class_id") @db.Uuid
  newSectionId      String?        @map("new_section_id") @db.Uuid
  // M2 Phase 3: nullable — history rows predate year-scoping and stay NULL
  // (no backfill). onDelete: SetNull matches the previousClass/newClass
  // relations on this same model — history survives even if the academic
  // year config is later deleted.
  academicYearId    String?        @map("academic_year_id") @db.Uuid
  promotionDate     DateTime       @map("promotion_date") @db.Timestamptz(3)
  promotionReason   String?        @map("promotion_reason")
  remarks           String?
  createdBy         String?        @map("created_by") @db.Uuid
  updatedBy         String?        @map("updated_by") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedBy         String?        @map("deleted_by") @db.Uuid
  deleteReason      String?        @map("delete_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  student           Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  previousClass     AcademicClass? @relation("StudentHistoryPreviousClass", fields: [previousClassId], references: [id], onDelete: SetNull)
  previousSection   Section?       @relation("StudentHistoryPreviousSection", fields: [previousSectionId], references: [id], onDelete: SetNull)
  newClass          AcademicClass? @relation("StudentHistoryNewClass", fields: [newClassId], references: [id], onDelete: SetNull)
  newSection        Section?       @relation("StudentHistoryNewSection", fields: [newSectionId], references: [id], onDelete: SetNull)
  academicYear      AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([newClassId])
  @@index([newSectionId])
  @@index([academicYearId])
  @@map("student_history")
}

model Contact {
  id             String            @id @default(uuid()) @db.Uuid
  studentId      String?           @map("student_id") @db.Uuid
  guardianId     String?           @map("guardian_id") @db.Uuid
  staffProfileId String?           @map("staff_profile_id") @db.Uuid
  personType     ContactPersonType @map("person_type")
  phone1         String
  phone2         String?
  whatsapp       String?
  address        String?
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?           @map("deleted_by") @db.Uuid
  deleteReason   String?           @map("delete_reason")
  activeScopeKey String            @default("ACTIVE") @map("active_scope_key")
