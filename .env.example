NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus
# Raise these if the database is in another region and saves time out (milliseconds).
DB_TRANSACTION_TIMEOUT_MS=20000
DB_TRANSACTION_MAX_WAIT_MS=10000
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
MASTER_LOGIN_KEY=replace-with-a-secure-random-string
TRIAL_DAYS=14
SUPERADMIN_SEED_NAME=Super Admin
SUPERADMIN_SEED_EMAIL=super@admin.com
SUPERADMIN_SEED_PASSWORD=replace-with-a-secure-password
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=Nexus

# Live socket alerts for superadmin (new contact inquiries). Off unless exactly "true".
# Also set CORS_ORIGINS to your frontend origin(s) when enabling in production.
REALTIME_ENABLED=false

# Web app address, used for links in emails (password reset).
APP_URL=http://localhost:3000

# Messages. `log` sends nothing and only records that a message would have been sent.
# Set NOTIFICATIONS_PROVIDER=smtp, with the SMTP values below, to send real email.
NOTIFICATIONS_PROVIDER=log
NOTIFICATIONS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Automated database backups. Leave false everywhere except the real production
# environment, and run one manual restore drill before turning it on.
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_KMS_KEY_ID=
# 64 hex characters, for example: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
# A scratch PostgreSQL server (not the live one) for the weekly restore check.
BACKUP_VERIFY_ADMIN_URL=
BACKUP_OBJECT_LOCK=true
# Days each tier is kept (defaults shown).
BACKUP_RETENTION_INTRADAY_DAYS=3
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_DAYS=84
BACKUP_RETENTION_MONTHLY_DAYS=365
BACKUP_RETENTION_YEARLY_DAYS=3653
